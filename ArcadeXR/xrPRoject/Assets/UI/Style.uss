.ip-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.ip-field {
    border-width: 1px;
    border-color: rgb(85, 85, 85);
    background-color: rgb(34, 34, 34);
}

.active-field {
    border-width: 2px;
    border-color: rgb(0, 162, 255);
    background-color: rgb(51, 51, 51);
    scale: 1.05;
}
.ip-field > .unity-label {
    color: white;
}
.unity-button:hover {
    background-color: rgba(255, 255, 255, 0.3); /* Button leuchtet auf, wenn Hand/Laser drauf ist */
    scale: 1.05;
}